.venv/
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/
dist/
build/
.lazarillo/
# example artefacts (regenerated by each example's build script)
examples/*/data/
examples/*/*/target/
examples/*/*/target_dev/
examples/*/*/logs/
examples/*/*/dbt_packages/
# MCP configs written by `lazarillo init --mcp`, with paths to this machine
examples/*/.mcp.json
examples/*/.cursor/
examples/*/.vscode/
.user.yml
